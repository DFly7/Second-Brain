// Tuist sets SDKROOT=iphoneos on the target; sdk-scoped overrides keep simulator builds valid.
SDKROOT[sdk=iphonesimulator*] = iphonesimulator
SDKROOT[sdk=iphoneos*] = iphoneos

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = V8S6S975CD

SLASH = /
// API is served under /api/ via prod nginx (frontend proxy). base + "/health" in code => /api/health
BACKEND_URL = https:$(SLASH)$(SLASH)smoothstudy.ai$(SLASH)api
AUTHENTIK_AUTHORIZE_URL = https:$(SLASH)$(SLASH)auth.smoothstudy.ai/application/o/authorize/
AUTHENTIK_TOKEN_URL = https:$(SLASH)$(SLASH)auth.smoothstudy.ai/application/o/token/
AUTHENTIK_CLIENT_ID = second-brain
AUTHENTIK_REDIRECT_URI = secondbrain:$(SLASH)$(SLASH)auth/callback
