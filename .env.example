# Canonical Pi deploy: clone/checkout lives at /home/darragh/second-brain/Second-Brain
# Run compose from that directory. This file is <repo-root>/.env (API/db/tunnel).
GEMINI_API_KEY=your-key-here
LITELLM_MODEL=gemini/gemini-2.0-flash
AUTHENTIK_ISSUER=https://auth.smoothstudy.ai/application/o/second-brain/
AUTHENTIK_JWKS_URI=https://auth.smoothstudy.ai/application/o/second-brain/jwks/
AUTHENTIK_CLIENT_ID=second-brain
AUTHENTIK_TOKEN_URL=https://auth.smoothstudy.ai/application/o/token/
AUTHENTIK_REDIRECT_URI=https://smoothstudy.ai/callback

# SPA OAuth (VITE_*) for prod Docker: set in frontend/.env — copied into the image at build time (see frontend/.env.example).
DATABASE_URL=postgresql+asyncpg://wiki:wiki@db:5432/wiki
S3_ENDPOINT=http://minio:9000
S3_BUCKET=wiki
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Hybrid search: query embedding vs pages.embedding. false = full-text only (no embedding API).
VECTOR_SEARCH_ENABLED=true

# Document conversion: datalab = Datalab managed API; local = self-hosted marker container (see docker-compose).
MARKER_BACKEND=datalab
DATALAB_API_KEY=
DATALAB_MODE=accurate

# Local marker only (when MARKER_BACKEND=local). Compose defaults MARKER_URL if unset.
MARKER_URL=http://marker:8001
MARKER_LLM_SERVICE=marker.services.gemini.GoogleGeminiService
MARKER_LLM_MODEL=
MARKER_LLM_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare Tunnel — get token from Zero Trust dashboard → Tunnels → <tunnel> → Configure → Install connector
CLOUDFLARE_TUNNEL_TOKEN=
