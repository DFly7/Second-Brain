FROM python:3.12-slim
WORKDIR /app

RUN groupadd --gid 1000 appuser \
  && useradd --uid 1000 --gid appuser --no-create-home --shell /sbin/nologin appuser

RUN apt-get update \
  && apt-get install -y --no-install-recommends gcc libpq-dev \
  && rm -rf /var/lib/apt/lists/*

COPY requirements-prod.txt .
RUN pip install --no-cache-dir -r requirements-prod.txt \
  && apt-get update \
  && apt-get purge -y gcc libpq-dev \
  && apt-get install -y --no-install-recommends libpq5 \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

COPY --chown=appuser:appuser . .

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "exec gunicorn app.main:app -w ${WEB_CONCURRENCY:-4} -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000"]
